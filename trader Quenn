# ── Main webhook ─────────────────────────────────────────────
@app.post("/webhook/tradingview", response_model=WebhookResponse)
async def tradingview_webhook(
    request: Request,
    background_tasks: BackgroundTasks,
):
    # 1. Verify secret
    if settings.WEBHOOK_SECRET:
        secret = request.headers.get("X-Webhook-Secret", "")
        if secret != settings.WEBHOOK_SECRET:
            log.warning(f"Rejected webhook — bad secret from {request.client.host}")
            raise HTTPException(status_code=401, detail="Invalid webhook secret")

    # 2. Parse body
    try:
        payload = await request.json()
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid JSON body")

    # 3. Validate model
    try:
        alert = TradingViewAlert(**payload)
    except Exception as e:
        raise HTTPException(status_code=422, detail=f"Payload validation error: {e}")

    # 4. Symbol whitelist
    if alert.symbol not in settings.ALLOWED_SYMBOLS:
        log.info(f"Symbol {alert.symbol} not in allowed list — ignored")
        return WebhookResponse(
            status="ignored",
            symbol=alert.symbol,
            message=f"{alert.symbol} is not in ALLOWED_SYMBOLS",
        )

    log.info(f"Webhook received: {alert.symbol} | {alert.action} | ${alert.price}")

    # 5. Queue analysis in background (respond fast to TradingView)
    background_tasks.add_task(_process_alert, alert)

    return WebhookResponse(
        status="accepted",
        symbol=alert.symbol,
        message="Alert queued for AI analysis",
    )


# ── Manual analysis ──────────────────────────────────────────
@app.get("/analyze/{symbol}")
async def manual_analyze(symbol: str, action: Optional[str] = "ANALYZE"):
    symbol = symbol.upper()
    if symbol not in settings.ALLOWED_SYMBOLS:
        raise HTTPException(
            status_code=400,
            detail=f"{symbol} not in ALLOWED_SYMBOLS: {settings.ALLOWED_SYMBOLS}",
        )

    log.info(f"Manual analysis: {symbol}")

    # Fetch data
    quote = await market.get_quote(symbol)
    hist  = await market.get_historical(symbol, days=60)
    news  = await market.get_news(symbol, limit=8)
    price = quote.get("price", 0.0)
    indicators = hist.get("indicators", {})

    # Risk evaluation
    risk_ctx = risk.evaluate(
        symbol=symbol,
        action=action.upper(),
        price=price,
        indicators=indicators,
        quote=quote,
    )

    # Claude analysis
    result = await analyzer.analyze(
        symbol=symbol,
        action=action.upper(),
        price=price,
        quote=quote,
        news=news,
        indicators=indicators,
        risk_context=risk_ctx,
    )

    # Telegram
    await telegram.send_analysis(result)

    return result


# ─────────────────────────────────────────────
# BACKGROUND PIPELINE
# ─────────────────────────────────────────────
async def _process_alert(alert: TradingViewAlert):
    """Full analysis pipeline — runs in background after webhook ack."""
    try:
        log.info(f"Processing: {alert.symbol} {alert.action}")

        # ── 1. Market data ─────────────────────────────────────
        quote, hist, news = await asyncio.gather(
            market.get_quote(alert.symbol),
            market.get_historical(alert.symbol, days=60),
            market.get_news(alert.symbol, limit=8),
        )

        price      = alert.price or quote.get("price", 0.0)
        indicators = {**hist.get("indicators", {}), **(alert.indicators or {})}

        # ── 2. Risk evaluation ────────────────────────────────
        risk_ctx = risk.evaluate(
            symbol=alert.symbol,
            action=alert.action,
            price=price,
            indicators=indicators,
            quote=quote,
        )

        # ── 3. Momentum gate ──────────────────────────────────
        # Quick pre-filter before calling Claude (saves API cost)
        strength = risk_ctx.get("signal_strength", "NEUTRAL")
        if strength == "NEUTRAL" and alert.action not in ("CLOSE", "ALERT"):
            log.info(f"  Signal too weak ({strength}) — Claude skipped, Telegram notified")
            await telegram.send_raw(
                f"ℹ️ <b>{alert.symbol}</b> alert received but signal strength is <b>NEUTRAL</b>.\n"
                f"Action: {alert.action} @ ${price:.4f} — no trade suggested."
            )
            return

        # ── 4. Claude AI analysis ─────────────────────────────
        analysis = await analyzer.analyze(
            symbol=alert.symbol,
            action=alert.action,
            price=price,
            quote=quote,
            news=news,
            indicators=indicators,
            risk_context=risk_ctx,
            timeframe=alert.timeframe or "1D",
            strategy=alert.strategy,
        )

        # ── 5. Minimum momentum gate ──────────────────────────
        score = analysis.get("momentum_score", 50)
        if (
            alert.action in ("BUY", "LONG")
            and score < settings.MIN_MOMENTUM_SCORE
        ):
            log.info(f"  Momentum {score} < threshold {settings.MIN_MOMENTUM_SCORE} — suppressed")
            await telegram.send_raw(
                f"⏭ <b>{alert.symbol}</b> BUY signal suppressed\n"
                f"Momentum score {score}/100 below threshold ({settings.MIN_MOMENTUM_SCORE}).\n"
                f"<i>{analysis.get('reasoning','')}</i>"
            )
            return

        # ── 6. Telegram alert ─────────────────────────────────
        await telegram.send_trade_alert(alert, analysis)
        log.info(
            f"Alert sent: {alert.symbol} | score={score} | "
            f"signal={analysis.get('overall_signal')} | risk={analysis.get('risk_level')}"
        )

    except Exception as e:
        log.error(f"Pipeline error [{alert.symbol}]: {e}", exc_info=True)
        await telegram.send_error(f"[{alert.symbol}] {e}", critical=False)


